apiVersion: v1
kind: Pod
metadata:
  name: openab-kind-network-probe
  namespace: openab-sessions
  labels:
    app.kubernetes.io/name: openab-kind-network-probe
spec:
  automountServiceAccountToken: false
  enableServiceLinks: false
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: probe
      image: __BROKER_IMAGE__
      imagePullPolicy: Never
      command:
        - /usr/bin/tini
        - --
        - /bin/sleep
        - "600"
      securityContext:
        allowPrivilegeEscalation: false
        privileged: false
        readOnlyRootFilesystem: true
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        capabilities:
          drop:
            - ALL
